    "@fontsource/rajdhani": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "alchemy": "2.0.0-beta.81",
    "astro": "7.3.5",
    "daisyui": "5.7.47",
    "effect": "4.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
